# Production environment template.
# Copy to .env.production and fill in real values — never commit the filled-in file.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Comma-separated, no spaces. Must include the real domain(s) the app is served from.
ALLOWED_HOSTS=example.com,www.example.com

# Required when behind HTTPS (default in production) so Django trusts POSTs
# from your domain. Comma-separated, scheme included.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# postgres://USER:PASSWORD@HOST:5432/DBNAME
# When using docker-compose.yml, only POSTGRES_PASSWORD needs to be set here —
# DATABASE_URL is assembled automatically from it.
DATABASE_URL=
POSTGRES_PASSWORD=
